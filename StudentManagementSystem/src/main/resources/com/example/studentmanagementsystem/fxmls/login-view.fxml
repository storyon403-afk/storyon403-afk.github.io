<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="400.0" prefWidth="600.0"
           maxWidth="Infinity" maxHeight="Infinity"
           style="-fx-background-image: url('/com/example/studentmanagementsystem/photos/login.png');
            -fx-background-repeat: no-repeat;
            -fx-background-size: cover;
            -fx-background-position: center;
            -fx-background-order: background;  /* 新增这行，强制背景图在最底层 */
            -fx-background-color: transparent;"

           xmlns="http://javafx.com/javafx/24.0.1"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.studentmanagementsystem.controller.Login_controller">

   <children>
         <Label fx:id="greet" text="Welcome!" textFill="#cadc26" StackPane.alignment="CENTER">
            <font>
             <Font name="Comic Sans MS Bold" size="36.0" />
          </font>
         </Label>

         <Button mnemonicParsing="false" onAction="#login" text="Login" StackPane.alignment="TOP_LEFT" />
   </children>
</StackPane>
